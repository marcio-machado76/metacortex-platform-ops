# --- Configuracao local do agente (opcao B: mora na raiz, nao e entregavel) ---
# Ancorados com barra inicial de proposito: sem ela, o padrao casa em QUALQUER
# profundidade e engoliria a copia canonica do .mcp.json que o Ticket 02 entrega
# em desafio-03/ticket-02-triagem-no-cluster/mcp/.
/.claude/
/.mcp.json

# --- Credenciais: nunca versionar ---
.secrets/
*.pem
*.key
id_rsa*
id_ed25519*
kubeconfig
.kube/

# --- Terraform ---
.terraform/
terraform.tfstate
terraform.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# --- Codigo de terceiros (workloads KubeDev sao clonados fora do repo) ---
workloads/

# --- Runtime ---
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.venv/
venv/
node_modules/
dist/
build/
.env

# --- Entregas anteriores consultadas como referencia ---
referencias/
